# Source publication uses an allowlist. Local research, screenshots, chat data,
# nested website checkout and binary releases stay on this machine.
/*
!/.gitignore
!/.github/
!/.gitleaks.toml
!/README.md
!/main.py
!/pyproject.toml
!/requirements.txt
!/requirements-reader.txt
!/requirements-build.txt
!/setup.ps1
!/启动心动微信.cmd
!/src/
!/web/
!/tests/
!/scripts/
!/assets/
!/packaging/
!/docs/
!/prototype-heart-wechat/
/assets/*
!/assets/heart-wechat.ico
!/assets/desktop-icon-export.json
/docs/*
!/docs/public/
!/docs/promotion/
/docs/public/project-readme.md
/prototype-heart-wechat/*
!/prototype-heart-wechat/src/
!/prototype-heart-wechat/public/
!/prototype-heart-wechat/tests/
!/prototype-heart-wechat/scripts/
!/prototype-heart-wechat/worker/
!/prototype-heart-wechat/.openai/
!/prototype-heart-wechat/package.json
!/prototype-heart-wechat/package-lock.json
!/prototype-heart-wechat/index.html
!/prototype-heart-wechat/vite.config.mjs
/prototype-heart-wechat/scripts/refine-selected-design.py
/scripts/*
!/scripts/prepare_reader.py
!/scripts/probe_wechat_db.py
!/scripts/export_desktop_icon.py
!/scripts/build_windows.ps1
!/scripts/preview_website.ps1
!/scripts/verify_background_pause_package.py
!/scripts/build_installer.ps1
!/scripts/verify_installer.ps1
!/scripts/sync_installer_download.ps1
!/scripts/collect_installer_notices.py
!/scripts/installer_resource_audit.py
!/scripts/windows_signing.ps1
!/scripts/sign_inno_file.ps1
!/scripts/prepare_webview2.ps1
!/scripts/webview2_runtime.ps1
!/scripts/test_webview2_prerequisite.ps1
!/scripts/test_release_guards.ps1
!/scripts/probe_native_chat_input.py
!/scripts/probe_native_voice.py
!/scripts/probe_reply_quality.py
!/scripts/migrate_desktop_data.py
!/evals/
/evals/*
!/evals/reply-usefulness.json
# No runtime or credential material, even under source folders.
**/node_modules/
**/.env*
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/*_acceptance-session*
**/*settings.local*
